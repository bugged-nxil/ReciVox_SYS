
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="‹  Create a Ping"
            android:textColor="#6946B8"
            android:textSize="25sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask your educator for help."
            android:textColor="#77718B"
            android:textSize="15sp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose ReciRoom"
            android:textColor="#29243D"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/roomSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6946B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What do you need help with?"
            android:textColor="#29243D"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6946B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Topic"
            android:textColor="#29243D"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/topicInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="e.g., Network Security"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#6946B8"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your question"
            android:textColor="#29243D"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/questionInput"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top|start"
            android:hint="Type your question or what you need clarified..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:backgroundTint="#6946B8"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Be specific so your educator can help you better."
            android:textColor="#77718B"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/attachButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋ Attach image or file (Optional)"
            android:textAllCaps="false"
            android:textColor="#6946B8"
            android:backgroundTint="#EDE4FC" />

        <CheckBox
            android:id="@+id/privateCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send privately to my educator"
            android:textColor="#29243D"
            android:checked="true"
            android:buttonTint="#6946B8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/sendPingButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Send Ping"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6946B8" />

    </LinearLayout>
</ScrollView>
