<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#F8F7FC">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ReciRoom"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#6C4AB6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Who are you?"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#252139"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose how you'll use ReciRoom."
            android:textSize="15sp"
            android:textColor="#817A91"
            android:gravity="center" />

        <Button
            android:id="@+id/learnerRoleButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:text="I'm a Learner"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C4AB6" />

        <Button
            android:id="@+id/educatorRoleButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="I'm an Educator"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6C4AB6"
            android:backgroundTint="#E9DDFB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="We Recieve Your Voice"
            android:textSize="13sp"
            android:textColor="#817A91"
            android:gravity="center" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>